# Copie para .env.local e preencha com os valores do projeto Supabase.
# .env.local é ignorado pelo git.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# URL pública do marketplace (usada em emails, redirects de auth, OG images).
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Catálogo e pedidos tradicionais são administrados pelo factory-control.
# A integração de saldo do cliente usa a API interna abaixo, somente no servidor.
CORE_API_URL=http://localhost:3001/api/v1
CUSTOMER_FINANCE_INTERNAL_TOKEN=
CUSTOMER_FINANCE_ENVIRONMENT=STAGE

# Service role — checkout, bot e verificação de pagamento (somente servidor).
SUPABASE_SERVICE_ROLE_KEY=

# Banco Cora — Integração Direta (mTLS). Tudo server-only, NUNCA NEXT_PUBLIC_.
CORA_ENV=stage
CORA_CLIENT_ID=
CORA_CERT_PATH=/caminho/para/certificate.pem
CORA_KEY_PATH=/caminho/para/private-key.key

# Notificações (ver SETUP-BOTS.md na raiz do monorepo). Server-only.
# Sem esses valores os envios são pulados (status "skipped" no notification_log).
# Telegram — bot interno da empresa (grupo fixo).
TELEGRAM_BOT_TOKEN=
TELEGRAM_INTERNAL_CHAT_ID=
# WhatsApp Cloud API (Meta) — notificação ao cliente.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Bot automático Evolution — ativar depois da migration 0009 e configuração comercial.
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_BOT_ENABLED=false
# disabled preserva a fila; live permite envio real. Não use live nos testes automatizados.
WHATSAPP_BOT_SEND_MODE=disabled
# Gere segredos aleatórios distintos com pelo menos 32 caracteres. Não use chaves NEXT_PUBLIC_.
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_LINK_SECRET=
